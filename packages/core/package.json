{
  "name": "@aguspe/tiler-core",
  "version": "0.0.1",
  "description": "Schemas, widget contract, and TilerStore interface for tiler-ts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aguspe/tiler-ts.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/aguspe/tiler-ts/tree/main/packages/core",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ulidx": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
